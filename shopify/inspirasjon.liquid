{% comment %}Paste into a Shopify Custom Liquid section. Set worker endpoint below. {% endcomment %}
{% assign inspiration_api = 'https://barnas-fristed-inspirasjon.fly.dev' %}
<section id="inspiration-app" data-api="{{ inspiration_api }}">
  <div class="insp-header">
    <div>
      <h1>La deg inspirere</h1>
      <p>Se bildene fra fellesskapet og del din egen inspirasjon.</p>
    </div>
    <button id="insp-open" type="button">Del et bilde eller video</button>
  </div>
  <div id="insp-grid" class="insp-grid" aria-live="polite"></div>
  <button id="insp-more" hidden type="button">Vis flere bilder</button>
  <dialog id="insp-dialog">
    <form id="insp-form">
      <button class="insp-close" type="button" id="insp-close" aria-label="Lukk">×</button>
      <h2>Del et bilde eller video</h2>
      <p>Bildet eller videoen blir gjennomgått før det publiseres.</p>
      <label
        >Bilde eller video (JPG, PNG, WebP, MP4, MOV eller WebM – video maks 15 sekunder)<input
          type="file"
          name="image"
          accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime,video/webm"
          required></label>
      <p id="insp-feedback" role="status"></p>
      <label>Navn (valgfritt)<input name="displayName" maxlength="80"></label
      ><label>Beskrivelse (valgfritt)<textarea name="description" maxlength="500"></textarea></label
      ><label
        >Produkt (valgfritt)<select name="productHandle" id="insp-products">
          <option value="">Ingen produkt valgt</option>
        </select></label
      ><label class="insp-check"
        ><input type="checkbox" name="galleryConsent" required> <span id="insp-gallery-text">Laster …</span></label
      ><label class="insp-check"
        ><input type="checkbox" name="marketingConsent"> <span id="insp-marketing-text"></span
      ></label>
      <p class="insp-privacy">
        Vi lagrer bildet eller videoen privat til det er godkjent. Se
        <a href="/policies/privacy-policy" target="_blank" rel="noopener">personvernerklæringen</a> for hvordan
        opplysninger behandles og hvor lenge de lagres.
      </p>
      <div id="insp-turnstile"></div>
      <button type="submit" id="insp-submit">Send til godkjenning</button>
    </form>
  </dialog>
  <dialog id="insp-lightbox" aria-label="Forstørret bilde">
    <button type="button" class="insp-lb-close" id="insp-lb-close" aria-label="Lukk">×</button
    ><button type="button" class="insp-lb-nav insp-lb-prev" id="insp-lb-prev" aria-label="Forrige bilde">‹</button
    ><button type="button" class="insp-lb-nav insp-lb-next" id="insp-lb-next" aria-label="Neste bilde">›</button>
    <div class="insp-lb-stage"><img id="insp-lb-img" alt=""><video id="insp-lb-video" controls playsinline preload="metadata" hidden></video></div>
    <div class="insp-lb-cap" id="insp-lb-cap" aria-live="polite"></div>
  </dialog>
</section>
<style>
  #inspiration-app {
