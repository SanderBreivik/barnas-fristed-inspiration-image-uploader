{% comment %}Paste into a Shopify Custom Liquid section. Set worker endpoint below. {% endcomment %}
{% assign inspiration_api = 'https://barnas-fristed-inspirasjon.fly.dev' %}
<section id="inspiration-app" data-api="{{ inspiration_api }}">
 <div class="insp-header"><div><h1>La deg inspirere</h1><p>Se bildene fra fellesskapet og del din egen inspirasjon.</p></div><button id="insp-open" type="button">Del ditt bilde</button></div>
 <div id="insp-grid" class="insp-grid" aria-live="polite"></div><button id="insp-more" hidden type="button">Vis flere bilder</button>
 <dialog id="insp-dialog"><form id="insp-form"><button class="insp-close" type="button" id="insp-close" aria-label="Lukk">×</button><h2>Del ditt bilde</h2><p>Bildet blir gjennomgått før det publiseres.</p><label>Bilde (JPG, PNG eller WebP)<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><label>Navn (valgfritt)<input name="displayName" maxlength="80"></label><label>Beskrivelse (valgfritt)<textarea name="description" maxlength="500"></textarea></label><label>Produkt (valgfritt)<select name="productHandle" id="insp-products"><option value="">Ingen produkt valgt</option></select></label><label class="insp-check"><input type="checkbox" name="galleryConsent" required> Jeg bekrefter at jeg har rett til å dele bildet, at nødvendige tillatelser fra avbildede personer er innhentet, og gir butikken tillatelse til å publisere bildet i inspirasjonsgalleriet. Jeg kan be om at bildet fjernes.</label><label class="insp-check"><input type="checkbox" name="marketingConsent"> Jeg gir i tillegg frivillig tillatelse til at bildet kan brukes i sosiale medier og betalte annonser, i henhold til <a href="/policies/privacy-policy" target="_blank" rel="noopener">personvernerklæringen</a>.</label><div id="insp-turnstile"></div><button type="submit" id="insp-submit">Send til godkjenning</button><p id="insp-feedback" role="status"></p></form></dialog>
</section>
<style>
#inspiration-app{max-width:1350px;margin:auto;padding:32px 16px;font-family:inherit} .insp-header{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:30px;flex-wrap:wrap}.insp-header h1{margin:0;font-size:clamp(30px,4vw,52px)}.insp-header p{margin:8px 0;color:#666}.insp-header button,#insp-submit,#insp-more{background:#252525;color:white;border:0;padding:12px 22px;border-radius:5px;cursor:pointer}.insp-grid{columns:4 230px;column-gap:16px}.insp-card{break-inside:avoid;margin:0 0 16px;overflow:hidden;border-radius:10px;background:#f5f5f5}.insp-card img{display:block;width:100%;height:auto}.insp-card figcaption{padding:10px 12px;font-size:14px}.insp-card a{color:inherit}#insp-more{display:block;margin:22px auto}#insp-more[hidden]{display:none}#insp-dialog{border:0;border-radius:12px;max-width:530px;width:calc(100% - 30px);max-height:90vh;overflow:auto;padding:30px}#insp-dialog::backdrop{background:rgba(0,0,0,.6)}#insp-form{display:grid;gap:16px}#insp-form>label{display:grid;gap:5px}#insp-form input:not([type=checkbox]),#insp-form select,#insp-form textarea{width:100%;padding:10px;border:1px solid #aaa;border-radius:4px}#insp-form .insp-check{display:flex;align-items:flex-start;gap:10px;font-size:14px}#insp-form .insp-check input{margin-top:4px}.insp-close{position:absolute;right:14px;top:10px;border:0;background:none;font-size:30px;cursor:pointer}#insp-feedback{margin:0} @media(max-width:550px){.insp-grid{columns:2 140px;column-gap:10px}.insp-card{margin-bottom:10px}}
</style>
<script>
(()=>{const root=document.getElementById('inspiration-app');if(!root)return;const api=root.dataset.api,grid=document.getElementById('insp-grid'),dialog=document.getElementById('insp-dialog'),form=document.getElementById('insp-form'),feedback=document.getElementById('insp-feedback'),more=document.getElementById('insp-more');let page=0,siteKey='',widgetId=null;
const node=(tag,cls,text)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(text)e.textContent=text;return e};
async function load(){more.disabled=true;try{const r=await fetch(`${api}/api/gallery?page=${page}`);if(!r.ok)throw Error('Kunne ikke hente bilder');const data=await r.json();for(const p of data.photos){const fig=node('figure','insp-card'),img=node('img');img.src=p.imageUrl;img.loading='lazy';img.alt=p.description||'Inspirasjonsbilde';fig.append(img);const cap=node('figcaption');if(p.description)cap.append(node('div','',p.description));if(p.display_name)cap.append(node('small','',`Delt av ${p.display_name}`));if(p.product_handle){const a=node('a','','Se produkt');a.href='/products/'+encodeURIComponent(p.product_handle);cap.append(a)}fig.append(cap);grid.append(fig)}page=data.nextPage;more.hidden=page===null}catch(e){grid.append(node('p','',e.message))}finally{more.disabled=false}}
async function config(){const r=await fetch(`${api}/api/config`);if(!r.ok)throw Error('Kunne ikke laste skjema');siteKey=(await r.json()).siteKey;}
function turnstile(){if(!siteKey)return;if(window.turnstile){widgetId=window.turnstile.render('#insp-turnstile',{sitekey:siteKey});return}const script=document.createElement('script');script.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';script.onload=()=>{widgetId=window.turnstile.render('#insp-turnstile',{sitekey:siteKey})};document.head.append(script)}
function convert(file){return new Promise((resolve,reject)=>{const img=new Image(),url=URL.createObjectURL(file);img.onload=()=>{const scale=Math.min(1,2000/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.round(img.width*scale);canvas.height=Math.round(img.height*scale);canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);URL.revokeObjectURL(url);canvas.toBlob(b=>b?resolve(b):reject(Error('Kunne ikke behandle bildet')),'image/webp',.85)};img.onerror=()=>{URL.revokeObjectURL(url);reject(Error('Ugyldig bildefil'))};img.src=url?url:''})}
async function products(){try{const r=await fetch('/products.json?limit=250');if(!r.ok)return;const data=await r.json(),sel=document.getElementById('insp-products');for(const p of data.products||[]){const o=document.createElement('option');o.value=p.handle;o.textContent=p.title;sel.append(o)}}catch{}}
document.getElementById('insp-open').onclick=async()=>{dialog.showModal();if(!siteKey){try{await config();turnstile()}catch(e){feedback.textContent=e.message}}};document.getElementById('insp-close').onclick=()=>dialog.close();more.onclick=load;
form.onsubmit=async e=>{e.preventDefault();const button=document.getElementById('insp-submit');button.disabled=true;feedback.textContent='Laster opp …';try{const f=new FormData(form),file=f.get('image');if(!file||file.size>15*1024*1024)throw Error('Velg et bilde under 15 MB');const blob=await convert(file);if(blob.size>8*1024*1024)throw Error('Bildet er for stort');f.set('image',blob,'photo.webp');f.set('galleryConsent',String(f.get('galleryConsent')==='on'));f.set('marketingConsent',String(f.get('marketingConsent')==='on'));f.set('turnstileToken',window.turnstile?.getResponse(widgetId)||'');const r=await fetch(`${api}/api/submit`,{method:'POST',body:f});const data=await r.json();if(!r.ok)throw Error(data.error||'Opplasting feilet');feedback.textContent='Takk! Bildet er sendt til godkjenning. Ta vare på slettelenken.';const link=`${api}/remove.html?id=${encodeURIComponent(data.id)}&token=${encodeURIComponent(data.removalToken)}`;const a=node('a','','Administrer eller slett bildet');a.href=link;a.target='_blank';a.rel='noopener';feedback.append(document.createTextNode(' '),a);form.reset()}catch(err){feedback.textContent=err.message}finally{button.disabled=false;window.turnstile?.reset(widgetId)}};
load();products();})();
</script>
