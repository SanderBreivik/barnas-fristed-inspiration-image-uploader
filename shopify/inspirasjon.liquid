<script>
  (() => {
    const root = document.getElementById('inspiration-app');
    if (!root) return;
    const api = root.dataset.api,
      grid = document.getElementById('insp-grid'),
      dialog = document.getElementById('insp-dialog'),
      form = document.getElementById('insp-form'),
      feedback = document.getElementById('insp-feedback'),
      more = document.getElementById('insp-more');
    let page = 0,
      siteKey = '',
      widgetId = null,
      consentVersion = '';
    const node = (tag, cls, text) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const photos = [],
      lb = document.getElementById('insp-lightbox'),
      lbImg = document.getElementById('insp-lb-img'),
      lbCap = document.getElementById('insp-lb-cap'),
      lbPrev = document.getElementById('insp-lb-prev'),
      lbNext = document.getElementById('insp-lb-next'),
      lbVid = document.getElementById('insp-lb-video');
    const stopVid = () => {
      lbVid.pause();
      lbVid.removeAttribute('src');
      lbVid.removeAttribute('poster');
      lbVid.load();
    };
    let cur = 0;
    const pcache = new Map();
    function productInfo(h) {
      if (!pcache.has(h))
        pcache.set(
          h,
          fetch('/products/' + encodeURIComponent(h) + '.js')
            .then((r) => (r.ok ? r.json() : null))
            .then((d) =>
              d && d.title
                ? {
                    title: d.title,
                    url: d.url || '/products/' + encodeURIComponent(h),
                    img: d.featured_image || (d.images && d.images[0]) || '',
                    available: d.available !== false,
                  }
                : null,
            )
            .catch(() => null),
        );
      return pcache.get(h);
    }
    function chip(h, into, guard) {
      productInfo(h).then((p) => {
        if (!p || (guard && !guard())) return;
        const a = node('a', 'insp-product');
        a.href = p.url;
        if (p.img) {
          const t = node('img', 'insp-pthumb');
          t.src = p.img.replace(/(\.\w+)(\?|$)/, '_100x100_crop_center$1$2');
          t.alt = '';
          t.width = 44;
          t.height = 44;
          a.append(t);
        }
        a.append(node('span', '', p.title + (p.available ? '' : ' (utsolgt)') + ' →'));
        into.append(a);
      });
    }
    function show(i) {
      if (i < 0 || i >= photos.length) return;
      cur = i;
      const p = photos[i];
      const vid = p.type === 'video';
      lbImg.hidden = vid;
      lbVid.hidden = !vid;
      if (vid) {
        lbVid.poster = p.thumbUrl;
        lbVid.src = p.videoUrl;
        lbVid.setAttribute('aria-label', p.description || 'Video');
        lbVid.play().catch(() => {});
      } else {
        stopVid();
        lbImg.src = p.imageUrl;
        lbImg.alt = p.description || 'Inspirasjonsbilde';
      }
      lbCap.replaceChildren();
      if (p.description) lbCap.append(node('div', '', p.description));
      if (p.display_name) lbCap.append(node('span', 'insp-by', `Delt av ${p.display_name}`));
      if (p.product_handle) chip(p.product_handle, lbCap, () => cur === i);
      lbPrev.hidden = i === 0;
      lbNext.hidden = i === photos.length - 1 && page === null;
    }
    async function step(d) {
      if (d > 0 && cur === photos.length - 1 && page !== null) await load();
      show(cur + d);
    }
    lbPrev.onclick = () => step(-1);
    lbNext.onclick = () => step(1);
    document.getElementById('insp-lb-close').onclick = () => lb.close();
    lb.addEventListener('keydown', (e) => {
      if (e.target === lbVid) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      }
    });
    lb.addEventListener('click', (e) => {
      if (e.target === lb) lb.close();
    });
    lb.addEventListener('close', () => {
      lbImg.removeAttribute('src');
      stopVid();
    });
    let tx = null;
    lb.addEventListener(
      'touchstart',
      (e) => {
        tx = e.touches[0].clientX;
      },
      { passive: true },
    );
    lb.addEventListener('touchend', (e) => {
      if (tx === null) return;
      const dx = e.changedTouches[0].clientX - tx;
      tx = null;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    });
    const canHover = matchMedia('(hover: hover) and (pointer: fine)'),
      reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    function hoverPlay(zoom, p) {
      let v = null,
        t = 0;
      const stop = () => {
        clearTimeout(t);
        if (v) {
          v.pause();
          v.removeAttribute('src');
          v.load();
          v.remove();
          v = null;
        }
        zoom.classList.remove('insp-playing');
      };
      zoom.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || !canHover.matches || reduceMotion.matches) return;
        t = setTimeout(() => {
          v = node('video', 'insp-hover');
          v.muted = true;
          v.loop = true;
          v.playsInline = true;
          v.preload = 'auto';
          v.tabIndex = -1;
          v.setAttribute('aria-hidden', 'true');
          v.addEventListener('playing', () => zoom.classList.add('insp-playing'));
          v.src = p.videoUrl;
          zoom.append(v);
          v.play().catch(stop);
        }, 200);
      });
      zoom.addEventListener('pointerleave', stop);
      zoom.addEventListener('click', stop);
    }
    const skel = () => {
      grid.setAttribute('aria-busy', 'true');
      [220, 300, 180, 260, 320, 200, 280, 240].forEach((h) => {
        const s = node('div', 'insp-card insp-skel');
        s.style.height = h + 'px';
        s.setAttribute('aria-hidden', 'true');
        grid.append(s);
      });
    };
    const clearSkel = () => {
      grid.removeAttribute('aria-busy');
      grid.querySelectorAll('.insp-skel').forEach((e) => e.remove());
    };
    const empty = () => {
      const d = node('div', 'insp-empty');
      d.append(
        node('strong', '', 'Ingen bilder ennå'),
        node('p', '', 'Bli den første til å dele et bilde med fellesskapet.'),
      );
      const b = node('button', '', 'Del et bilde eller video');
      b.type = 'button';
      b.onclick = () => document.getElementById('insp-open').click();
      d.append(b);
      grid.append(d);
    };
    async function load() {
      more.disabled = true;
      const first = page === 0 && !photos.length;
      if (first) skel();
      try {
        const r = await fetch(`${api}/api/gallery?page=${page}`);
        if (!r.ok) throw Error('Kunne ikke hente bilder');
        const data = await r.json();
        clearSkel();
        for (const p of data.photos) {
          const fig = node('figure', 'insp-card'),
            img = node('img');
          img.src = p.thumbUrl || p.imageUrl;
          if (p.thumbUrl)
            img.onerror = () => {
              img.onerror = null;
              img.src = p.imageUrl;
            };
          if (p.width && p.height) {
            img.width = p.width;
            img.height = p.height;
          }
          img.decoding = 'async';
          img.loading = 'lazy';
          img.alt = p.description || 'Inspirasjonsbilde';
          const idx = photos.push(p) - 1,
            zoom = node('button', 'insp-zoom');
          zoom.type = 'button';
          zoom.setAttribute(
            'aria-label',
            (p.type === 'video' ? 'Spill av video' : 'Forstørr bilde') + (p.description ? ': ' + p.description : ''),
          );
          zoom.onclick = () => {
            show(idx);
            if (!lb.open) lb.showModal();
          };
          zoom.append(img);
          if (p.type === 'video') {
            zoom.append(node('span', 'insp-play', '▶'));
            hoverPlay(zoom, p);
          }
          fig.append(zoom);
          const cap = node('figcaption');
          if (p.description) cap.append(node('div', '', p.description));
          if (p.display_name) cap.append(node('span', 'insp-by', `Delt av ${p.display_name}`));
          if (p.product_handle) chip(p.product_handle, cap);
          fig.append(cap);
          grid.append(fig);
        }
        if (!photos.length) empty();
        page = data.nextPage;
        more.hidden = page === null;
      } catch (e) {
        clearSkel();
        grid.append(node('p', '', e.message));
      } finally {
        more.disabled = false;
      }
    }
    async function config() {
      const r = await fetch(`${api}/api/config`);
      if (!r.ok) throw Error('Kunne ikke laste skjema');
      siteKey = (await r.json()).siteKey;
      const c = await fetch(`${api}/api/consent`);
      if (!c.ok) throw Error('Kunne ikke laste samtykketekst');
      const d = await c.json();
      consentVersion = d.version;
      document.getElementById('insp-gallery-text').textContent = d.galleryText;
      document.getElementById('insp-marketing-text').textContent = d.marketingText;
    }
    function turnstile() {
      if (!siteKey) return;
      if (window.turnstile) {
        widgetId = window.turnstile.render('#insp-turnstile', { sitekey: siteKey });
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.onload = () => {
        widgetId = window.turnstile.render('#insp-turnstile', { sitekey: siteKey });
      };
      document.head.append(script);
    }
    async function sendImage(f) {
      const r = await fetch(`${api}/api/submit`, { method: 'POST', body: f });
      return { ok: r.ok, data: await r.json() };
    }
    function sendVideo(f, onPct) {
      return new Promise((resolve, reject) => {
        const x = new XMLHttpRequest();
        x.open('POST', `${api}/api/submit-video`);
        x.upload.onprogress = (e) => {
          if (e.lengthComputable) onPct(Math.round((e.loaded / e.total) * 100));
        };
        x.onload = () => {
          let d = {};
          try {
            d = JSON.parse(x.responseText);
          } catch {}
          resolve({ ok: x.status >= 200 && x.status < 300, data: d });
        };
        x.onerror = () => reject(Error('Kunne ikke nå serveren. Prøv igjen.'));
        x.send(f);
      });
    }
    function convert(file) {
      return new Promise((resolve, reject) => {
        const img = new Image(),
          url = URL.createObjectURL(file);
        img.onload = () => {
          const scale = Math.min(1, 2000 / Math.max(img.width, img.height));
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(img.width * scale);
          canvas.height = Math.round(img.height * scale);
          canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
          URL.revokeObjectURL(url);
          canvas.toBlob((b) => (b ? resolve(b) : reject(Error('Kunne ikke behandle bildet'))), 'image/webp', 0.85);
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          reject(Error('Ugyldig bildefil'));
        };
        img.src = url ? url : '';
      });
    }
    async function products() {
      try {
        const sel = document.getElementById('insp-products');
        for (let pg = 1; pg <= 10; pg++) {
          const r = await fetch('/products.json?limit=250&page=' + pg);
          if (!r.ok) break;
          const list = (await r.json()).products || [];
          for (const p of list) {
            const o = document.createElement('option');
            o.value = p.handle;
            o.textContent = p.title;
            sel.append(o);
          }
          if (list.length < 250) break;
        }
      } catch {}
    }
    const showReceipt = (on) => {
      for (const c of form.children) {
        if (c.id === 'insp-feedback' || c.id === 'insp-close' || c.tagName === 'H2') continue;
        c.hidden = on;
      }
    };
    const say = (msg, isError = false) => {
      feedback.textContent = msg;
      feedback.classList.toggle('insp-error', isError);
      feedback.setAttribute('role', isError ? 'alert' : 'status');
      if (isError) feedback.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    const fileInput = form.querySelector('input[type=file]');
    const isVideoFile = (f) => f.type.startsWith('video/') || /\.(mp4|mov|webm)$/i.test(f.name);
    const fileProblem = (msg) => Object.assign(Error(msg), { file: true });
    const rejectFile = (msg) => {
      fileInput.value = '';
      say(msg + ' Velg en annen fil.', true);
    };
    fileInput.addEventListener('change', () => {
      say('');
      const f = fileInput.files[0];
      if (!f) return;
      const video = isVideoFile(f);
      if (f.size > (video ? 150 : 15) * 1024 * 1024)
        return rejectFile(video ? 'Videoen er for stor (maks 150 MB).' : 'Bildet er for stort (maks 15 MB).');
      if (!video) return;
      const url = URL.createObjectURL(f),
        probe = document.createElement('video');
      probe.preload = 'metadata';
      probe.onloadedmetadata = () => {
        URL.revokeObjectURL(url);
        if (fileInput.files[0] === f && probe.duration > 15.5) rejectFile('Videoen er for lang (maks 15 sekunder).');
      };
      probe.onerror = () => URL.revokeObjectURL(url);
      probe.src = url;
    });
    document.getElementById('insp-open').onclick = async () => {
      if (form.dataset.done) {
        form.reset();
        showReceipt(false);
        say('');
        delete form.dataset.done;
        window.turnstile?.reset(widgetId);
      }
      dialog.showModal();
      if (!siteKey) {
        try {
          await config();
          turnstile();
        } catch (e) {
          say(e.message, true);
        }
      }
    };
    document.getElementById('insp-close').onclick = () => dialog.close();
    more.onclick = load;
    form.onsubmit = async (e) => {
      e.preventDefault();
      const button = document.getElementById('insp-submit');
      button.disabled = true;
      say('Laster opp …');
      try {
        const f = new FormData(form),
          file = f.get('image'),
          isVideo = !!file && isVideoFile(file);
        if (!file || file.size > (isVideo ? 150 : 15) * 1024 * 1024)
          throw fileProblem(isVideo ? 'Videoen er for stor (maks 150 MB).' : 'Bildet er for stort (maks 15 MB).');
        if (isVideo) {
          f.delete('image');
          f.set('video', file);
        } else {
          const blob = await convert(file).catch((e) => {
            throw fileProblem(e.message);
          });
          if (blob.size > 8 * 1024 * 1024) throw fileProblem('Bildet er for stort.');
          f.set('image', blob, 'photo.webp');
        }
        f.set('galleryConsent', String(f.get('galleryConsent') === 'on'));
        f.set('marketingConsent', String(f.get('marketingConsent') === 'on'));
        f.set('turnstileToken', window.turnstile?.getResponse(widgetId) || '');
        f.set('consentVersion', consentVersion);
        const { ok, data } = isVideo
          ? await sendVideo(f, (pct) => {
              say(pct < 100 ? `Laster opp … ${pct} %` : 'Sjekker videoen …');
            })
          : await sendImage(f);
        if (!ok) throw data.field === 'file' ? fileProblem(data.error) : Error(data.error || 'Opplasting feilet');
        const link = `${api}/remove.html?id=${encodeURIComponent(data.id)}&token=${encodeURIComponent(data.removalToken)}`;
        feedback.replaceChildren(
          node('strong', '', isVideo ? 'Takk! Videoen er sendt til godkjenning.' : 'Takk! Bildet er sendt til godkjenning.'),
          node(
            'p',
            '',
            (isVideo ? 'Videoen komprimeres først, så det kan ta litt tid før den kan godkjennes. ' : '') +
              'Ta vare på denne slettelenken. Det er den eneste måten å fjerne ' +
              (isVideo ? 'videoen' : 'bildet') +
              ' på, og vi kan ikke sende den på nytt.',
          ),
        );
        const a = node('a', '', 'Administrer eller slett');
        a.href = link;
        a.target = '_blank';
        a.rel = 'noopener';
        const inp = node('input');
        inp.readOnly = true;
        inp.setAttribute('value', link);
        inp.value = link;
        inp.setAttribute('aria-label', 'Slettelenke');
        const copy = node('button', '', 'Kopier lenke');
        copy.type = 'button';
        copy.onclick = async () => {
          try {
            await navigator.clipboard.writeText(link);
            copy.textContent = 'Kopiert!';
          } catch {
            inp.select();
            copy.textContent = 'Marker og kopier manuelt';
          }
        };
        feedback.append(a, inp, copy);
        form.reset();
        showReceipt(true);
        form.dataset.done = '1';
      } catch (err) {
        if (err.file) fileInput.value = '';
        say(err.message + (err.file ? ' Velg en annen fil.' : ''), true);
      } finally {
        button.disabled = false;
        window.turnstile?.reset(widgetId);
      }
    };
    load();
    products();
  })();
</script>
